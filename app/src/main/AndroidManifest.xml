<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        서비스 바인딩 권한과 <queries>는 각 SDK가 매니페스트에 자동으로 합쳐 넣습니다.
        Vehicle SDK 메서드마다 필요한 권한은 SDK의 @RequiresPermission에 적혀 있습니다
        (예: Odometer.getCurrentDistanceDriven → CAR_DRIVE). 차량 데이터를 더 읽으려면 CAR_*,
        제어하려면 CONTROL_CAR_* 권한을 추가하세요. CAR_*·CONTROL_CAR_*·NAVI_*·TTS/STT 권한은
        normal 등급이라 설치할 때 자동으로 부여됩니다.
    -->

    <!-- Vehicle SDK: 첫 화면의 누적 주행거리 읽기 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- NaviHelper SDK: 조회(get*·requestTrip)는 NAVI_ROUTE, 경로 요청·경유지·취소는 NAVI_ROUTE_SEARCH,
         내비 화면 전환(requestNavigationScreen)은 NAVI_CUSTOM_MAP -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />

    <!-- TextToSpeech / SpeechToText SDK -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- FusedLocation SDK: dangerous 등급이라 위치를 쓰기 전에 실행 중 권한 요청이 필요합니다. -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- Vehicle SDK: 탑승자 맞이 준비(공조 온도·시트 열선) 읽기와 제어 -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />

    <!-- Audeo 서버 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Audeo 통화 음성(WebRTC): 마이크는 dangerous 등급이라 실행 중에 허락을 받습니다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Audeo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- 주행 중에도 쓰는 화면(Distraction Optimized). 실제 배포 전 Pleos 심사가 필요합니다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
